[18.29, "o", " \u001b[36;1m\u25b2 preflight\u001b[0m \u001b[2mv0.1.0 \u00b7 what your agent is about to inherit\u001b[0m\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n  \u001b[2mcwd      \u001b[0m ~/Downloads/cool-repo\r\n  \u001b[2mgit root \u001b[0m ~/Downloads/cool-repo\r\n  \u001b[2mscanned  \u001b[0m 3 dirs, ~/Downloads/cool-repo \u2192 ~\r\n  \u001b[2magent    \u001b[0m \u001b[32;1mcodex\u001b[0m\r\n\r\n \u001b[36;1mINSTRUCTION FILES\u001b[0m\u001b[2m (3)\u001b[0m\r\n  \u001b[33;1m\u2717\u001b[0m \u001b[33;1mCHANGED \u001b[0m \u001b[1m~/Downloads/cool-repo/AGENTS.md\u001b[0m  \u001b[35;1m\u2b07 downloaded\u001b[0m  \u001b[33m\u2691 2 flags\u001b[0m\r\n  \u001b[32m\u2713\u001b[0m \u001b[32mTRUSTED \u001b[0m ~/Downloads/cool-repo/.mcp.json  \u001b[35;1m\u2b07 downloaded\u001b[0m  \u001b[33m\u2691 1 flag\u001b[0m\r\n  \u001b[32m\u2713\u001b[0m \u001b[32mTRUSTED \u001b[0m ~/.codex/config.toml             \r\n\r\n \u001b[36;1mMCP SERVERS\u001b[0m\u001b[2m (2)\u001b[0m\r\n  \u001b[34m\u2022\u001b[0m \u001b[1mhelper\u001b[0m  npx -y totally-legit-mcp --api-key \u2022\u2022\u2022  \u001b[2m~/Downloads/cool-repo/.mcp.json\u001b[0m\r\n  \u001b[34m\u2022\u001b[0m \u001b[1mdocs  \u001b[0m  docs-mcp  \u001b[2m~/.codex/config.toml\u001b[0m\r\n\r\n \u001b[36;1mPERMISSIONS & SANDBOX\u001b[0m\u001b[2m\u001b[0m\r\n  \u001b[2m\u00b7\u001b[0m \u001b[2mcodex \u001b[0m approval_policy = on-request  \u001b[2m~/.codex/config.toml\u001b[0m\r\n  \u001b[2m\u00b7\u001b[0m \u001b[2mcodex \u001b[0m sandbox_mode = workspace-write  \u001b[2m~/.codex/config.toml\u001b[0m\r\n\r\n \u001b[36;1mSECRETS IN REACH\u001b[0m\u001b[2m (1)\u001b[0m\r\n  \u001b[33;1m!\u001b[0m \u001b[33m.env\u001b[0m\r\n\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n  \u001b[37;41;1m BLOCKED \u001b[0m  1 untrusted instruction file\r\n     \u001b[31m\u2022\u001b[0m ~/Downloads/cool-repo/AGENTS.md: changed since trusted; in ~/Downloads; high-risk: prompt-in\u2026\r\n     \u001b[33m\u26a0\u001b[0m ~/Downloads/cool-repo/.mcp.json is trusted but in ~/Downloads\r\n     \u001b[2mreview the file(s) above, then run:\u001b[0m \u001b[1mpreflight trust\u001b[0m\r\n"]
[18.291, "o", "(exit 3)\r\n"]
[18.291, "o", "\r\ncanary file /tmp/preflight-canary does not exist: nothing was executed.\r\n"]
[21.292, "o", "\r\n"]
